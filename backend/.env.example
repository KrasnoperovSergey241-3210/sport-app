# Скопируйте в backend/.env и измените значения
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# Основная БД (медицинские записи, учётные записи по внутреннему коду)
DB_NAME=sport_main
DB_USER=sport
DB_PASSWORD=sport_dev_password
DB_HOST=localhost
DB_PORT=5433
# БД с персональными данными (ФИО, e-mail, телефон)
PII_DB_NAME=sport_pii

REDIS_URL=redis://localhost:6379/0

# Одноразовые коды: в dev коды печатаются в консоль; DEV_ECHO_OTP=True добавляет код в ответ API (ТОЛЬКО для разработки!)
DEV_ECHO_OTP=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.local
# SMS: console | (свой провайдер — см. apps/accounts/services.py)
SMS_BACKEND=console
# Push: console | fcm
PUSH_BACKEND=console
# За обратным прокси (nginx): True — брать IP из X-Forwarded-For
TRUST_PROXY=False
